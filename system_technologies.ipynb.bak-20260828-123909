    "n = train_sizes_abs.astype(float)[1:]\n",
    "n_ref = np.median(n)\n",
    "\n",
    "\n",
    "def f(n, a, b, c):\n",
    "    return a + b * (n / n_ref) ** (-c)\n",
    "\n",
    "\n",
    "def fit_scaling_law(curve, a_lower_frac=0.3):\n",
    "    \"\"\"Fit rmse(n) = a + b*(n/n_ref)^(-c) to one model's validation learning curve.\n",
    "\n",
    "    `curve` is the (n_sizes, n_folds) validation RMSE array for that model. Points\n",
    "    are weighted by the per-size fold std. `a_lower_frac` sets the lower bound on\n",
    "    the asymptote `a` as a fraction of the smallest observed RMSE.\n",
    "    \"\"\"\n",
    "    rmse_mean = curve[1:].mean(axis=1)\n",
    "    rmse_std = np.clip(curve[1:].std(axis=1, ddof=1), 1e-6, None)\n",
    "\n",
    "    a0 = rmse_mean[-1]\n",
    "    b0 = max(rmse_mean[0] - a0, 1e-6)\n",
    "    c0 = 0.5\n",
    "    a_lower = max(a_lower_frac * rmse_mean.min(), 1e-6)\n",
    "\n",
    "    popt, pcov = curve_fit(\n",
    "        f,\n",
    "        n,\n",
    "        rmse_mean,\n",
    "        p0=[a0, b0, c0],\n",
    "        sigma=rmse_std,\n",
    "        absolute_sigma=True,\n",
    "        bounds=([a_lower, 0, 0.05], [np.inf, np.inf, 20.0]),\n",
    "        maxfev=20000\n",
    "    )\n",
    "    return {\n",
    "        \"popt\": popt, \"pcov\": pcov, \"a_lower\": a_lower,\n",
    "        \"rmse_mean\": rmse_mean, \"rmse_std\": rmse_std,\n",
    "    }\n",
    "\n",
    "\n",
    "fits = {name: fit_scaling_law(curve) for name, curve in val_rmse.items()}\n",
    "\n",
    "for name, fit in fits.items():\n",
    "    a, b, c = fit[\"popt\"]\n",
    "    rmse_mean, rmse_std = fit[\"rmse_mean\"], fit[\"rmse_std\"]\n",
    "    res = rmse_mean - f(n, a, b, c)\n",
    "\n",
    "    weighted_r2 = 1 - np.sum((res / rmse_std) ** 2) / np.sum(\n",
    "        ((rmse_mean - np.average(rmse_mean, weights=1 / rmse_std**2)) / rmse_std) ** 2\n",
    "    )\n",
    "\n",
    "    param_se = np.sqrt(np.diag(fit[\"pcov\"]))\n",
    "    dof = max(len(n) - len(fit[\"popt\"]), 1)\n",
